<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>E_Learning_Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="src\learnova.LearningService.Application\learnova.LearningService.Application.csproj" />
    <None Include="src\learnova.LearningService.Domain\learnova.LearningService.Domain.csproj" />
    <None Include="src\learnova.LearningService.Infrastructure\learnova.LearningService.Infrastructure.csproj" />
    <None Include="src\learnova.LearningService.Persistence\learnova.LearningService.Persistence.csproj" />
    <None Include="src\learnova.LearningService\learnova.LearningService.csproj" />
  </ItemGroup>

  <!-- Exclude source files under src/learnova.* projects so they are compiled by their own project files only -->
  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <EmbeddedResource Remove="src\**\*" />
    <None Remove="src\**\*" />
    <Content Remove="src\**\*" />
    <!-- Also exclude tests so the root web project does not implicitly compile test sources -->
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Content Remove="tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\learnova.LearningService.Domain\Properties\AssemblyInfo.cs" />
    <Compile Include="src\learnova.LearningService.Persistence\Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup><!-- Mapper files removed from root project; they are compiled by Persistence project csproj -->
    <None Include="src\learnova.LearningService.Persistence\README.md" />
    <!-- Test project removed from root None items to avoid duplicate inclusion when it's added to the solution -->
  </ItemGroup>

</Project>
